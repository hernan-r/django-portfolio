# Copiá este archivo como .env y completá los valores reales.
# Nunca subas tu .env al repositorio.

# Clave secreta de Django (generala con:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
DJANGO_SECRET_KEY=cambia-esta-clave-en-produccion
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Si usás HTTPS en producción, agregá tu dominio:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://tudominio.com

# En producción Django redirige a HTTPS y usa cookies seguras.
# Descomentá solo si tu proxy no envía X-Forwarded-Proto:
# DJANGO_SECURE_SSL_REDIRECT=True

# ---------------------------------------------------------------------------
# Base de datos
# En Render se configura automáticamente desde render.yaml.
# Para PostgreSQL en local o en otro hosting:
# ---------------------------------------------------------------------------
# DATABASE_URL=postgresql://usuario:password@127.0.0.1:5432/portfolio

# Alternativa MySQL (por defecto SQLite si no definís nada):
# DB_ENGINE=mysql
# DB_NAME=portfolio
# DB_USER=root
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306

# ---------------------------------------------------------------------------
# Email del formulario de contacto
# En desarrollo los mails se imprimen en la consola.
# ---------------------------------------------------------------------------
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.tuproveedor.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=tu-usuario
# EMAIL_HOST_PASSWORD=tu-password
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=Portfolio <no-reply@tudominio.com>
# Recibí una copia de cada mensaje en este correo:
# CONTACT_NOTIFICATION_EMAIL=tu@email.com

# ---------------------------------------------------------------------------
# Archivos subidos (media)
# En Render, usá un disco persistente o un storage externo.
# ---------------------------------------------------------------------------
# DJANGO_MEDIA_ROOT=/var/data/media
